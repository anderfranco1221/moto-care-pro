# Copy to .env and fill in. Every key here is required unless marked
# optional — the app validates them at boot (src/config/env.validation.ts)
# and refuses to start if any is missing or malformed.

# Shared Prisma project (Tenant, User) — migrated against `public`.
DATABASE_URL="postgresql://admin:1234@localhost:5433/moto-pro"

# Per-tenant Prisma project (Motorcycle, Service, Appointment) — its
# migrations are replayed against each tenant_<slug> schema, never `public`.
# Usually the same server as DATABASE_URL; kept separate so it is an explicit
# choice, not an accidental default.
TENANT_DATABASE_URL="postgresql://admin:1234@localhost:5433/moto-pro"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=86400

# HTTP port
PORT=3000

# Optional. pino log level: fatal|error|warn|info|debug|trace|silent.
# Defaults to debug in dev, info in production.
# LOG_LEVEL=debug
