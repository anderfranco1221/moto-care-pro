enum ProvisioningStatus {
  PENDING
  READY
  FAILED
}

model Tenant {
  id                 String             @id @default(uuid())
  name               String
  schemaName         String             @unique
  // Schema provisioning (CREATE SCHEMA + tenant migrations) runs after the
  // Tenant+User transaction commits, so it can fail independently. This
  // column is the source of truth for whether the tenant's schema is
  // usable: AuthService.signIn refuses to hand out a token while it isn't
  // READY and re-drives provisioning, so a transient failure at signup is
  // recoverable instead of a dead end.
  provisioningStatus ProvisioningStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  users              User[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  // Global unique, not per-tenant: UsersService.findOne(email) has no
  // tenant filter (login doesn't know the tenant ahead of time), so a
  // per-tenant unique constraint would let the same email exist under two
  // tenants while the app can only ever resolve one of them at login.
  // Revisit together if/when a tenant-aware login flow is built.
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
}
