model Tenant {
  id         String   @id @default(uuid())
  name       String
  schemaName String   @unique
  createdAt  DateTime @default(now())
  users      User[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  name      String?
  password  String
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
}
