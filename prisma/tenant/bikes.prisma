model Motorcycle {
  id           String        @id @default(uuid())
  vin          String        @unique
  brand        String
  model        String
  year         Int
  ownerId      String
  services     Service[]
  appointments Appointment[]
}

model Service {
  id             String          @id @default(uuid())
  motorcycleId   String
  description    String
  performedAt    DateTime        @default(now())
  mechanic       String?
  motorcycle     Motorcycle      @relation(fields: [motorcycleId], references: [id])
  stockMovements StockMovement[]
}

model Appointment {
  id           String     @id @default(uuid())
  userId       String
  motorcycleId String
  scheduledAt  DateTime
  notes        String?
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id])
}
